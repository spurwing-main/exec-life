.DS_Store

# This repo is PUBLIC. It holds the JS modules that get loaded into the Webflow
# site and nothing else — no client copy, no Designer working copies, no audit
# output, no scraped pages. Everything below stays on disk locally and out of
# the repo. Think hard before un-ignoring any of it.

# Designer working copies: the embed CSS's real home is the Webflow Designer,
# and the README documented the site's internals (page ids, embed names).
webflow/

# Cloudflare Worker — scaffold only, nothing deployed depended on it.
worker/

# Reference pages scraped from live sites (other clients' markup, site ids).
aethos.html

# Local reference / scratch
test-output/
outputs/
scratchpad/
scratch/
seo-backup/
FIGMA.md
/figma-assets

# Audit / spec output — regenerable, and stale the moment the site republishes
QA-FINDINGS.md
figma-map.json
design-spec.*.json

# Paste-ready copy for the Designer, not site source
legal-content/
